## local.properties.example
## Copy this file to local.properties and fill in your real keys
## ⚠️ NEVER commit local.properties to git

# Android SDK path (auto-generated by Android Studio)
# sdk.dir=/Users/your-username/Library/Android/sdk

# Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
# Get yours at: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
